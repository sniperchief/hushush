# PostgreSQL for the web app (auth tables) AND the payroll service (payroll tables).
DATABASE_URL=postgres://hushush:CHANGE_ME@localhost:5432/hushush
# Internal payroll-api service (never exposed to browsers).
PAYROLL_API_URL=http://127.0.0.1:7878
PAYROLL_API_TOKEN=generate-a-random-secret-of-at-least-32-chars
# Public origin of this app: worker links, CSRF origin checks and the passkey
# (WebAuthn) origin. Passkeys are bound to its host name (the Relying Party ID):
# changing the host later makes existing passkeys unusable.
APP_URL=http://localhost:3000
# Optional: override the WebAuthn Relying Party ID (default: APP_URL's host).
WEBAUTHN_RP_ID=
# Outgoing mail (not used for sign-in since Phase 5; kept for notifications).
# Required in production if mail is sent. In development, mail is written to
# the dev_outbox table and logged instead.
SMTP_URL=
MAIL_FROM="hushush <no-reply@example.com>"
